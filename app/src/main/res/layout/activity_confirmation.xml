<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Ambient Glow Circle Top Right -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient Glow Circle Bottom Left -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Decorative Coffee Bean Watermark Top Right -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-30dp"
        android:contentDescription="@null"
        android:rotation="25"
        android:src="@drawable/ic_bg_coffee_bean_deco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative Coffee Bean Watermark Bottom Left -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="@null"
        android:rotation="-30"
        android:src="@drawable/ic_bg_coffee_bean_deco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Content Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="28dp">

        <!-- Center Success Illustration Icon -->
        <ImageView
            android:id="@+id/ivOkCircle"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:contentDescription="@string/btn_oke"
            android:src="@drawable/ic_ok_circle"
            app:layout_constraintBottom_toTopOf="@+id/tvOrderPlacedTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Title: "Hey, [User Name]" -->
        <TextView
            android:id="@+id/tvOrderPlacedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Hey, Nama"
            android:textColor="#2D1E18"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivOkCircle" />

        <!-- Description Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/order_confirm_msg"
            android:textColor="#6E5A50"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@+id/btnOke"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOrderPlacedTitle" />

        <!-- Bottom Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOke"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="36dp"
            android:backgroundTint="#2D1E18"
            android:text="@string/btn_oke"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

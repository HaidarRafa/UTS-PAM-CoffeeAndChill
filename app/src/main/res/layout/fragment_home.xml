<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Ambient Glow Circle Top Right -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient Glow Circle Bottom Left -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Decorative Coffee Bean Top Right -->
    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-30dp"
        android:contentDescription="@null"
        android:rotation="25"
        android:src="@drawable/ic_bg_coffee_bean_deco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Header Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Halo Nama,"
            android:textColor="#2D1E18"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/cardAvatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreetingSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:text="@string/greeting_sub"
            android:textColor="#6E5A50"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/cardAvatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvGreetingSub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvGreeting"
            app:strokeColor="#E8D8C8"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_uts2" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHeader">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCoffee"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coffee"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNonCoffee"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Non-coffee"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJuice"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juice"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMakanan"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSnacks"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snacks"
                android:textColor="@color/chip_text_color"
                app:checkedIconTint="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background_color"
                app:chipStrokeColor="@color/chip_stroke_color"
                app:chipStrokeWidth="1.2dp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Section Title -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/section_makanan"
        android:textColor="#2D1E18"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hsvCategories" />

    <!-- Food RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFoodList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSectionTitle" />

    <!-- Floating Cart Summary Bar (Visible when items in cart > 0) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCartBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="96dp"
        android:visibility="gone"
        app:cardBackgroundColor="#2D1E18"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCartCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Item"
                    android:textColor="#E8D8C8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCartTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 22.000"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#FAF5EF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                android:text="Checkout →"
                android:textAllCaps="false"
                android:textColor="#2D1E18"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
